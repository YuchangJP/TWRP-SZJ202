# TWRP recovery fstab for the KYOCERA SZJ-JS202 (szj202).
#
# Derived from the stock recovery.img fstab (build 1.110JS.0151.a). The stock
# "wait,avb" options are dropped so an unsigned custom recovery can mount the
# partitions. The stock "userdata_zemi" line is omitted: that partition does
# not exist in this unit's GPT.
#
# <device>                                  <mount point>        <fstype> <options>                                                       <flags>

/dev/block/bootdevice/by-name/system        /system              ext4     ro,barrier=1                                                wait
/dev/block/bootdevice/by-name/vendor        /vendor              ext4     ro,barrier=1                                                wait
/dev/block/bootdevice/by-name/cache         /cache               ext4     noatime,nosuid,nodev,barrier=1,data=ordered                 wait,check
# TWRP only treats this as a file-based-encryption device when the line carries
# keydirectory= (partition.cpp checks TWPartition::Key_Directory), and the stock
# fstab says fileencryption=ice. Without them TWRP falls through to the
# FDE/crypto-footer path, which always fails on this device, so the
# credential-encrypted /data/data could never be unlocked.
/dev/block/bootdevice/by-name/userdata      /data                ext4     noatime,nosuid,nodev,barrier=1,noauto_da_alloc             wait,check,fileencryption=ice,keydirectory=/data/misc/vold
/dev/block/bootdevice/by-name/persist       /persist             ext4     nosuid,nodev,barrier=1,noauto_da_alloc                      wait,check
/dev/block/bootdevice/by-name/sysprop       /mnt/vendor/pstore   ext4     nosuid,nodev,barrier=1,noauto_da_alloc,data=journal,errors=panic wait,check,nofail
/dev/block/bootdevice/by-name/dsp           /dsp                 ext4     noatime,nosuid,nodev,barrier=1,data=ordered                 wait,check

/dev/block/bootdevice/by-name/boot          /boot                emmc     defaults                                                    defaults
/dev/block/bootdevice/by-name/recovery      /recovery            emmc     defaults                                                    defaults
/dev/block/bootdevice/by-name/misc          /misc                emmc     defaults                                                    defaults
/dev/block/bootdevice/by-name/splash        /splash              emmc     defaults                                                    defaults
/dev/block/bootdevice/by-name/dtbo          /dtbo                emmc     defaults                                                    defaults
/dev/block/bootdevice/by-name/modem         /firmware            vfat     ro,shortname=lower,uid=1000,gid=1000,dmask=0227,fmask=0337  wait

# Removable storage, in TWRP's own fstab format (mount point first, so TWRP
# treats it as version 1 and honours the flags). The previous AOSP-style entry
# carried "wait", which made TWRP block and report a mount error at boot for
# /usb_otg even when nothing was attached.
/external_sd                                auto    /dev/block/mmcblk1p1    /dev/block/mmcblk1    flags=display="MicroSD";storage;wipeingui;removable
/usb_otg                                    auto    /dev/block/sda1         /dev/block/sda        flags=display="USB OTG";storage;wipeingui;removable
