#
# Recovery USB and block-device bring-up for the KYOCERA SZJ-JS202 (MSM8937).
#
# Imported by TWRP's init.rc as /init.recovery.${ro.hardware}.rc because
# androidboot.hardware=qcom.
#
# The device is a configfs USB gadget (androidboot.usbconfigfs=true). TWRP's
# own init.rc leaves adbd disabled and never writes to /config/usb_gadget, so
# nothing would ever bring the controller up on its own. The gadget is created
# here from the factory recovery's setup and adbd is started explicitly; adbd
# opens functionfs and sets sys.usb.ffs.ready, which then binds the UDC.
#

on init
    # The device key in /data/unencrypted/key is stored in the Keymaster-wrapped
    # form (encrypted_key + keymaster_key_blob), which is what Android 9 vold
    # writes. Declare that up front: TWRP's own "try the wrapped form" retry in
    # partition.cpp only fires when TW_IS_FBE is already set, which it never is
    # this early, so without this the key can never be unwrapped and TWRP falls
    # back to the FDE path.
    setprop fbe.data.wrappedkey true
    mkdir /config
    mount configfs none /config
    mkdir /config/usb_gadget/g1 0770 shell shell
    write /config/usb_gadget/g1/bcdUSB 0x0200
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0xd001
    mkdir /config/usb_gadget/g1/strings/0x409 0770 shell shell
    write /config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno}
    write /config/usb_gadget/g1/strings/0x409/manufacturer ${ro.product.manufacturer}
    write /config/usb_gadget/g1/strings/0x409/product ${ro.product.model}
    mkdir /config/usb_gadget/g1/functions/ffs.adb
    write /config/usb_gadget/g1/os_desc/use 1
    write /config/usb_gadget/g1/os_desc/b_vendor_code 0x1
    write /config/usb_gadget/g1/os_desc/qw_sign "MSFT100"
    setprop sys.usb.configfs 1

on property:ro.boot.usbcontroller=*
    setprop sys.usb.controller ${ro.boot.usbcontroller}

# adbd has opened /dev/usb-ffs/adb and set sys.usb.ffs.ready; expose the
# function and bind the controller so the host enumerates 18d1:d001.
on property:sys.usb.ffs.ready=1
    mkdir /config/usb_gadget/g1/configs/b.1 0777 shell shell
    symlink /config/usb_gadget/g1/configs/b.1 /config/usb_gadget/g1/os_desc/b.1
    mkdir /config/usb_gadget/g1/configs/b.1/strings/0x409 0770 shell shell
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "adb"
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f1
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    setprop twrp.dbg.fs 1

# The Keymaster stack needed to unwrap the FBE device key. qseecomd loads its TA
# from the modem partition, which recovery never mounts on its own, and
# hwservicemanager has to be listening before the Keymaster service starts.
#
# The vendor binaries' ELF interpreter is /system/bin/linker64. This device is
# system-as-root: the system image's own /bin is a symlink to /system/bin, so
# mounting the image directly on /system makes that path self-referential
# ("Too many symbolic links"). Mount it on /system_root and publish the few
# paths the binaries need as symlinks instead.
on post-fs-data
    setprop twrp.dbg.pfd 1
    mkdir /system_root 0775 root root
    mount ext4 /dev/block/bootdevice/by-name/system /system_root ro
    symlink /system_root/system/bin /system/bin
    symlink /system_root/system/lib64 /system/lib64
    symlink /system_root/system/lib /system/lib
    # /vendor and /firmware refuse init's mount builtin; the shell's mount works.
    # Like the services, the exec needs an explicit SELinux context or init
    # silently skips it.
    exec u:r:su:s0 root root -- /sbin/setup-extra-mounts.sh
    setprop twrp.dbg.mnt 1
    start hwservicemanager

on property:hwservicemanager.ready=true
    setprop twrp.dbg.hws 1
    start vendor.qseecomd
    start keymaster-4-0

# init refuses to start a service whose binary has no SELinux domain transition,
# so every one of these needs an explicit seclabel. u:r:su:s0 is the permissive
# domain TWRP already uses for its root processes. They also have to run as root:
# the ramdisk files land as 0750 root:root, so a `system` uid cannot execve them.
# qseecomd only stays alive when /vendor is mounted, so the vendor libs are on
# the search path as well.
service hwservicemanager /sbin/hwservicemanager
    class core
    user root
    group root
    seclabel u:r:su:s0

service vendor.qseecomd /sbin/qseecomd
    class core
    user root
    group root
    seclabel u:r:su:s0
    env LD_LIBRARY_PATH /sbin:/vendor/lib64:/system/lib64

service keymaster-4-0 /sbin/android.hardware.keymaster@4.0-service-qti
    class early_hal
    user root
    group root
    seclabel u:r:su:s0
    env LD_LIBRARY_PATH /sbin:/vendor/lib64:/system/lib64

# TWRP's Keymaster wrapper probes every HAL version (4.0, 3.0, ...). The 3.0
# interface has no working implementation on this device - its QTI HAL aborts on
# open in recovery with "get_version status failed" because the TA it expects is
# not present - so setup-extra-mounts.sh shadows the passthrough library with
# /dev/null and the probe is skipped. Only the 4.0 service is started here.

# Gatekeeper, which verifies the lockscreen credential and so unlocks the CE
# storage under /data/data, is the remaining piece: TWRP's synthetic-password
# path needs the HIDL 1.0 interface, and this device's QTI implementation also
# aborts on open in recovery for the same reason, so /data/data stays locked.
# The passthrough library is shadowed as well, so the failure is clean rather
# than a crash.

# Runs after the functionfs mount in init.rc's "on fs" action.
on boot
    setprop sys.usb.config adb
    start adbd
